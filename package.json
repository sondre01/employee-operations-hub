{
  "name": "proposal-employee-hub",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "start:backend": "dotnet run --project backend/src/EmployeeHub.Api --launch-profile http",
    "dev:portal": "npm --prefix apps/employee-portal run dev",
    "dev:tickets": "npm --prefix apps/ticketing-desk run dev",
    "build:portal": "npm --prefix apps/employee-portal run build",
    "build:tickets": "npm --prefix apps/ticketing-desk run build",
    "build": "npm --prefix apps/employee-portal run build && npm --prefix apps/ticketing-desk run build"
  }
}
